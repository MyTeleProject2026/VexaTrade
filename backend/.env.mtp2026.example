# MTP2026 ARM64 guest-image contract
#
# The four distributable guest bundles are intentionally release artifacts,
# not source placeholders. Configure these values on the VexaTrade backend
# deployment after the MTP2026 physical-test release is published.
MTP2026_GUEST_RELEASE_BASE_URL=
MTP2026_GUEST_RELEASE_TAG=mtp2026-physical-test
MTP2026_GUEST_SHA256_MTP2026=
MTP2026_GUEST_SHA256_ANDROID=
MTP2026_GUEST_SHA256_WINDOWS11=
MTP2026_GUEST_SHA256_GAMING=
