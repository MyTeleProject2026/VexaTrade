# VexaTrade backend production environment template. Real secrets belong only in Render.
NODE_ENV=production
PORT=5000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=cryptopulse_v3
DB_CONNECTION_LIMIT=10
JWT_SECRET=

# Single VexaAccount SSO configuration. JSON is intentionally one environment variable.
# redirectUri is the deployed VexaTrade user callback route.
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"<VEXAACCOUNT_CLIENT_ID>","clientSecret":"<VEXAACCOUNT_CLIENT_SECRET>","redirectUri":"https://www.vexatrade-v.2bd.net/auth/callback","timeoutMs":10000}

FRONTEND_URL=https://www.vexatrade-v.2bd.net
FRONTEND_USER_URL=https://www.vexatrade-v.2bd.net
FRONTEND_ADMIN_URL=https://admin.vexatrade-v.2bd.net
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
FROM_EMAIL=
MAIL_FROM_NAME=VexaTrade
