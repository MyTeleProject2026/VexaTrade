# VexaTrade backend production environment template. Do not commit real values.
NODE_ENV=production
PORT=5000

# TiDB/MySQL
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=cryptopulse_v3
DB_CONNECTION_LIMIT=10

# Authentication
JWT_SECRET=

# VexaAccount SSO
VEXA_ACCOUNT_URL=https://api-vexaaccount.onrender.com
VEXA_ACCOUNT_CLIENT_ID=
VEXA_ACCOUNT_CLIENT_SECRET=
VEXA_ACCOUNT_REDIRECT_URI=
VEXA_ACCOUNT_SSO_STATE_SECRET=
VEXA_ACCOUNT_TIMEOUT_MS=10000

# Frontends / CORS
CLIENT_ORIGIN=
FRONTEND_URL=
FRONTEND_USER_URL=
FRONTEND_ADMIN_URL=
FRONTEND_EMPLOYEEMONITOR_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo email
BREVO_API_KEY=
FROM_EMAIL=
MAIL_FROM_NAME=VexaTrade

# Optional legacy SMTP compatibility
KEPLERS_PASSWORD=
SMTP_PASS=
