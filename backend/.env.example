# VexaTrade backend
NODE_ENV=production
PORT=5000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# VexaAccount consumer configuration. Keep the client secret in a separate server-side secret.
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"<VEXAACCOUNT_CLIENT_ID>","redirectUri":"https://www.vexatrade-v.2bd.net/auth/callback","scopes":"openid profile email","timeoutMs":10000}
VEXA_ACCOUNT_CLIENT_SECRET=<VEXAACCOUNT_CLIENT_SECRET>

FRONTEND_URL=https://www.vexatrade-v.2bd.net
# Additional exact browser origins allowed to call this API, comma-separated; no wildcard origins.
VEXATRADE_FRONTEND_ORIGINS=https://admin.vexatrade-v.2bd.net,https://www.vexatrade-v.2bd.net

# Optional TRON Grid API key for higher rate limits on public TRX/TRC20 balance, activity and block lookups.
# Configure in the Render backend Environment only; never expose it in frontend code.
TRONGRID_API_KEY=

# Etherscan API V2 read-only public balance/transaction lookups. Set the key in Render backend Environment only.
# Never place provider API keys in frontend code or commit a real key.
ETHERSCAN_API_KEY=

# Optional provider integration readiness registry (secrets belong in Render Environment, never commit them)
# Use dedicated READ-ONLY exchange API keys; do not grant withdrawal permissions.
EXCHANGE_BITGET_API_KEY=
EXCHANGE_BITGET_API_SECRET=
EXCHANGE_BITGET_API_PASSPHRASE=
# Bitget read-only Spot account balances; disable withdrawals and restrict API IPs. Never use withdrawal-enabled keys here.
# Coinbase Advanced Trade CDP key name and PEM private key; read-only account permission only.
# For multiline PEM values in Render, preserve newlines or encode them as literal \\n.
EXCHANGE_COINBASE_API_KEY=
EXCHANGE_COINBASE_API_SECRET=
EXCHANGE_OKX_API_KEY=
EXCHANGE_OKX_API_SECRET=
EXCHANGE_OKX_API_PASSPHRASE=
EXCHANGE_CRYPTOCOM_API_KEY=
EXCHANGE_CRYPTOCOM_API_SECRET=
EXCHANGE_BINANCE_API_KEY=
EXCHANGE_BINANCE_API_SECRET=
EXCHANGE_KRAKEN_API_KEY=
EXCHANGE_KRAKEN_API_SECRET=
EXCHANGE_BYBIT_API_KEY=
EXCHANGE_BYBIT_API_SECRET=

# WalletConnect-compatible user wallet linking requires a project ID and explicit user approval.
WALLETCONNECT_PROJECT_ID=

# Treasury signer readiness only. Do not enable broadcasting until audited chain-specific
# transaction construction, destination/amount policy, signer authorization, and receipt verification exist.
TREASURY_SIGNER_PROVIDER=
TREASURY_SIGNER_URL=
TREASURY_SIGNER_API_KEY=
TREASURY_SIGNER_NETWORKS=

# Alchemy server-side RPC credentials. Add real values only in Render Environment, never commit them.
ALCHEMY_ETH_MAINNET_API_KEY=
ALCHEMY_OPTIMISM_SEPOLIA_API_KEY=
# Optional single-key mode: pair ALCHEMY_API_KEY with ALCHEMY_NETWORK=eth-mainnet or opt-sepolia.
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=
