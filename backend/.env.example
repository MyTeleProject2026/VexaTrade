# VexaTrade backend
NODE_ENV=production
PORT=5000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# Single VexaAccount SSO configuration (keep clientSecret server-side).
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"<VEXAACCOUNT_CLIENT_ID>","clientSecret":"<VEXAACCOUNT_CLIENT_SECRET>","redirectUri":"https://www.vexatrade-v.2bd.net/auth/callback","timeoutMs":10000}

FRONTEND_URL=https://www.vexatrade-v.2bd.net
