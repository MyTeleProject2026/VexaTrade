# VexaTrade backend
NODE_ENV=production
PORT=5000

# VexaTrade's own TiDB/MySQL database
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=

# VexaTrade application session signing secret
JWT_SECRET=

# Central VexaAccount SSO
VEXA_ACCOUNT_URL=https://api-vexaaccount.onrender.com
VEXA_ACCOUNT_CLIENT_ID=
VEXA_ACCOUNT_CLIENT_SECRET=
VEXA_ACCOUNT_REDIRECT_URI=
VEXA_ACCOUNT_SSO_STATE_SECRET=
VEXA_ACCOUNT_TIMEOUT_MS=10000

# Frontend URLs
FRONTEND_URL=
