# VexaTrade backend
NODE_ENV=production
PORT=5000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# VexaAccount consumer configuration. Keep the client secret in a separate server-side secret.
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"<VEXAACCOUNT_CLIENT_ID>","redirectUri":"https://www.vexatrade-v.2bd.net/auth/callback","scopes":"openid profile email","timeoutMs":10000}
VEXA_ACCOUNT_CLIENT_SECRET=<VEXAACCOUNT_CLIENT_SECRET>

FRONTEND_URL=https://www.vexatrade-v.2bd.net
